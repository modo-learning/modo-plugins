{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/modo-learning/modo-plugins/plugins/modo-ai-skills/skills/export-assessment/assessment-record.schema.json",
  "title": "Modo AI Skills assessment record",
  "description": "The only data that may leave Claude when an assessment is exported as a report or saved to the Modo passport (it is the whole input of the Modo connector's save_assessment tool). See RECORD.md. Two shapes: a single-chat record (no scope field) and a multi-chat record (scope multi_chat). The conventions that a not_shown capability records confidence low and has no quote cannot be expressed here, nor can the multi-chat rules that tie the counts, dates, combined levels and coverage to the per-chat summaries, and the integer type here accepts 4.0; scripts/validate_assessment_record.py enforces all of these and is authoritative.",
  "oneOf": [{ "$ref": "#/$defs/single_chat" }, { "$ref": "#/$defs/multi_chat" }],
  "$defs": {
    "single_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "capabilities", "evidence", "session_title", "session_date"],
      "properties": {
        "rubric_version": { "$ref": "#/$defs/rubric_version" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["problem_solving", "verification", "workflow_design", "delegation", "strategic_thinking"],
          "properties": {
            "problem_solving": { "$ref": "#/$defs/capability" },
            "verification": { "$ref": "#/$defs/capability" },
            "workflow_design": { "$ref": "#/$defs/capability" },
            "delegation": { "$ref": "#/$defs/capability" },
            "strategic_thinking": { "$ref": "#/$defs/capability" }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "quote"],
            "properties": {
              "capability": { "$ref": "#/$defs/capability_key" },
              "quote": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        },
        "session_title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "session_date": { "$ref": "#/$defs/date" }
      }
    },
    "multi_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "scope", "capabilities", "evidence", "session_title", "session_date",
                   "chats_assessed", "chats", "coverage"],
      "properties": {
        "rubric_version": { "$ref": "#/$defs/rubric_version" },
        "scope": { "const": "multi_chat" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["problem_solving", "verification", "workflow_design", "delegation", "strategic_thinking"],
          "properties": {
            "problem_solving": { "$ref": "#/$defs/multi_capability" },
            "verification": { "$ref": "#/$defs/multi_capability" },
            "workflow_design": { "$ref": "#/$defs/multi_capability" },
            "delegation": { "$ref": "#/$defs/multi_capability" },
            "strategic_thinking": { "$ref": "#/$defs/multi_capability" }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "chat", "quote"],
            "properties": {
              "capability": { "$ref": "#/$defs/capability_key" },
              "chat": { "type": "integer", "minimum": 1, "maximum": 25 },
              "quote": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        },
        "session_title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "session_date": { "$ref": "#/$defs/date" },
        "chats_assessed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "scored", "too_short", "could_not_be_read", "from", "to"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 25 },
            "scored": { "type": "integer", "minimum": 1, "maximum": 25 },
            "too_short": { "type": "integer", "minimum": 0, "maximum": 25 },
            "could_not_be_read": { "type": "integer", "minimum": 0, "maximum": 25 },
            "from": { "$ref": "#/$defs/date" },
            "to": { "$ref": "#/$defs/date" }
          }
        },
        "chats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": { "$ref": "#/$defs/chat_summary" }
        },
        "coverage": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "rubric_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)?$" },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "capability_key": {
      "enum": ["problem_solving", "verification", "workflow_design", "delegation", "strategic_thinking"]
    },
    "level": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 5 }, { "const": "not_shown" }] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence"],
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "multi_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence", "best_shown", "trend", "chats_shown"],
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "best_shown": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 5 }, { "type": "null" }] },
        "trend": { "enum": ["up", "flat", "down", null] },
        "chats_shown": { "type": "integer", "minimum": 0, "maximum": 25 }
      }
    },
    "chat_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "result", "levels"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "date": { "$ref": "#/$defs/date" },
        "result": { "enum": ["scored", "too_short", "could_not_be_read"] },
        "levels": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["problem_solving", "verification", "workflow_design", "delegation", "strategic_thinking"],
              "properties": {
                "problem_solving": { "$ref": "#/$defs/level" },
                "verification": { "$ref": "#/$defs/level" },
                "workflow_design": { "$ref": "#/$defs/level" },
                "delegation": { "$ref": "#/$defs/level" },
                "strategic_thinking": { "$ref": "#/$defs/level" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
